# Copier ce fichier en .env pour le développement local.
# Ne jamais committer le fichier .env réel.

SECRET_KEY=change-moi-avec-une-cle-secrete-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Fournie par Render/Neon en production. En local, laisser vide pour
# retomber sur SQLite, ou renseigner une URL Postgres locale.
DATABASE_URL=
DATABASE_SSL_REQUIRE=False

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

TIME_ZONE=Africa/Lome
